{
  "name": "vitrine",
  "private": true,
  "version": "0.0.0",
  "description": "Site vitrine — homepage « batterie en première personne »",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
